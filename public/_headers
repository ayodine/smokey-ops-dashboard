# 1. HTML entrypoints - NEVER cache so browsers always request latest bundle hashes
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 2. Service Worker & Web Manifest - NEVER cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# 3. Content-hashed immutable assets (Vite JS/CSS bundles) - 1 year immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
